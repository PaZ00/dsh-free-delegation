{
  "name": "@local/dsh-free-delegation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mandatory subagent delegation for root cloud agents, with two executor routes: a cheap default and an escalation model.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "subagent",
    "delegation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PaZ00/dsh-free-delegation.git"
  },
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "test/mandate.test.mjs",
    "test/enforcement.test.mjs",
    "test/mutation-check.mjs"
  ],
  "scripts": {
    "test": "node test/mandate.test.mjs && node test/enforcement.test.mjs && node test/mutation-check.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
